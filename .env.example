# Copy to .env (`cp .env.example .env`) and change the password.
# .env is git-ignored; this example file contains placeholders only.

# --- PostgreSQL ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=appdb

# Backend -> DB. Compose service name `postgres` is resolved by Docker's DNS.
DB_HOST=postgres
DB_PORT=5432

# --- Frontend ---
# URL the *browser* uses to reach the backend (so it is the published host port).
API_BASE_URL=http://localhost:4000/api
# Origin allowed by the backend's CORS policy (the frontend's published origin).
CORS_ORIGIN=http://localhost:3000

# --- Platform services (Task 5) ---
REDIS_HOST=redis
REDIS_PORT=6379
SEARCH_URL=http://search:9200
